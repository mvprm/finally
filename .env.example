# Copy to .env and fill in. .env is gitignored.

# Required for real AI chat: OpenRouter API key
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in market simulator (recommended).
MASSIVE_API_KEY=

# Optional: "true" for deterministic mock LLM responses (testing, no API key needed)
LLM_MOCK=false

# Optional: SQLite file location. Default: db/finally.db at the project root
# (/app/db/finally.db in the container). Leave commented out in Docker.
# DB_PATH=
